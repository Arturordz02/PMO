# Entorno y credenciales locales
.env
.env.*
env.php
!env.example.php
!.env.example
!private_app/app/Core/Env.php

# Control de versiones e IDEs locales
.git/
.vscode/
.idea/

# Archivos comprimidos y temporales
*.log
*.zip
*.rar
*.7z
release/
pmo_temp/
_site/

# Almacenamiento y runtime en private_app
private_app/storage/logs/*
private_app/storage/cache/*
private_app/storage/reports/*
private_app/storage/outbox/*
private_app/storage/sessions/*

# Conservar marcadores de estructura y seguridad
!private_app/storage/**/
!private_app/storage/**/.gitkeep
!private_app/storage/**/.htaccess
