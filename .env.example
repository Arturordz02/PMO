# ==============================================================================
# PMO SOLUTIONS - Variables de Entorno (Plantilla .env.example)
# ==============================================================================
# Copie este archivo como .env para desarrollo local o configure estas variables
# directamente en el panel de control de su hosting (cPanel / Apache / FastCGI).
# NUNCA suba un archivo .env con contraseñas reales al repositorio de control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General de la Aplicación
# ------------------------------------------------------------------------------
PMO_APP_ENV=production
PMO_APP_DEBUG=false
PMO_SITE_URL=https://pmo-solutions.com

# ------------------------------------------------------------------------------
# 2. Base de Datos MySQL (PDO)
# ------------------------------------------------------------------------------
# Dejar PMO_DB_ENABLED=false hasta configurar la base de datos en cPanel
PMO_DB_ENABLED=false
PMO_DB_HOST=localhost
PMO_DB_PORT=3306
PMO_DB_NAME=
PMO_DB_USER=
PMO_DB_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Servidor de Correo SMTP Corporativo
# ------------------------------------------------------------------------------
PMO_SMTP_HOST=mail.pmo-solutions.com
PMO_SMTP_PORT=587
PMO_SMTP_ENCRYPTION=tls
PMO_SMTP_USER=comercial@pmo-solutions.com
PMO_SMTP_PASSWORD=



