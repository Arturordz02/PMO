# ==============================================================================
# PMO SOLUTIONS - Acceso a Recursos del Módulo Chatbot
# ==============================================================================

# Permitir servir assets públicos del chatbot y la base de conocimiento
<FilesMatch "^(chatbot\.(css|js)|knowledge\.json)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Bloquear acceso HTTP directo a archivos de configuración y documentación
<FilesMatch "^(config\.php|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

