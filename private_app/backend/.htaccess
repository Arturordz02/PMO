# ==============================================================================
# PMO SOLUTIONS - Seguridad de Directorio Backend (Apache .htaccess)
# Bloqueo total de acceso web directo (schemas, migraciones y datos internos)
# ==============================================================================

# Deshabilitar listado de directorios
Options -Indexes

# Bloquear todo acceso web directo al directorio backend
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>